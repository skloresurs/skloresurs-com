---
import "@/styles/global.css";
import GoogleAnalytics from "@astro-kits/google-analytics";
import { GoogleTagmanagerPartytown } from "@digi4care/astro-google-tagmanager";
import { SEO } from "astro-seo";
import Footer from "@/components/Footer.astro";
import Navbar from "@/components/navbar/Navbar.astro";
import { getLocale } from "@/paraglide/runtime";
import LiveChat from "@/scripts/LiveChat.astro";
import generateSeoData from "@/utils/seo";

const { pathname } = Astro.url;

interface Props {
  title?: string;
  description?: string;
  hideFooter?: boolean;
}

const { title, description, hideFooter } = Astro.props;

const seo = generateSeoData({
  title,
  description,
  pathname,
});
---

<!doctype html>
<html lang={getLocale()}>
	<head>
		<script
			type="text/javascript"
			src="https://app.termly.io/resource-blocker/7c598e80-a00e-49eb-bf87-a41eecfbfc27?autoBlock=on"
		></script>

		<!--
			ClientRouter (View Transitions) вилучено свідомо. Він підмінював <body>
			на кожній навігації, і разом із ним гинуло все, що сторонні скрипти
			вставляють у рантаймі: банер згоди Termly і всі 12 його <style>
			(заміряно на проді — зникали з першої ж навігації), автоблокувальник
			Termly, посилання Consent Preferences, віджет Chatwoot та слухачі
			перемикача мови.

			Через це AOS і preline більше не можна ініціалізувати на
			`astro:page-load` — цю подію дispatch-ить саме ClientRouter
			(astro/dist/transitions/router.js:406), і без нього вона не спрацює
			ніколи. Використовуємо `load`: при початковому завантаженні
			`astro:page-load` зводився рівно до нього, тому таймінг незмінний.
			Для AOS це принципово — він рахує офсети один раз, і робити це треба
			після завантаження зображень.
		-->
		<script>
			import AOS from "aos";
			window.addEventListener("load", () => {
				AOS.init();
			});
		</script>
		<SEO {...seo} />
		<meta name="generator" content={Astro.generator} />
		<GoogleAnalytics />
		<GoogleTagmanagerPartytown id={import.meta.env.G_TAG_MANAGER} />
		<LiveChat />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
	</head>

	<body class="bg-background text-white flex flex-col min-h-dvh">
		<div class="flex-1">
			<Navbar />
			<main>
				<slot />
			</main>
		</div>
		{!hideFooter && <Footer />}
	</body>
</html>

<script src="../../node_modules/preline/preline.js"></script>
<script>
	window.addEventListener("load", async () => {
		const preline = await import("preline/dist/preline.js");
		preline.HSStaticMethods.autoInit();
	});
</script>

<script>
	import { apply } from "@directus/visual-editing";

	document.addEventListener("DOMContentLoaded", async () => {
		apply({ directusUrl: "https://cms.skloresurs.com" });
	});
</script>
